# Read by your shell, not automatically by the launcher.
# export CUDA_VISIBLE_DEVICES=0
# export CLEF_DATA_DIR=/absolute/path/to/models/full
# export CLEF_MODEL_DIR=model-nf4
# export CLEF_MAX_LENGTH=16384
# Calibrated text builds compute their limit from idle GPU memory by default.
# export CLEF_CONTEXT_LIMIT_MODE=auto
# export CLEF_CONTEXT_RESERVE_MIB=512
# To enforce CLEF_MAX_LENGTH instead, use CLEF_CONTEXT_LIMIT_MODE=fixed.
# Full defaults to the computed image budget; Flash retains its validated cap.
# export CLEF_IMAGE_PREFILL=1
# export CLEF_MAX_IMAGE_LENGTH=8192

# Full automatic image budget requires calibrated incremental image prefill.
# export CLEF_IMAGE_PREFILL=1
# export CLEF_MAX_IMAGE_LENGTH=auto

# Both HTTP builds use remaining VRAM with adaptive cache headroom.
# Idle/short calls keep 256 MiB; calibrated incremental prefill keeps >=512 MiB.
# Active requests evict cached entries to make room for projected workspace.
# export CLEF_PREFIX_CACHE_ELASTIC=1
# export CLEF_PREFIX_CACHE_GPU_UTILIZATION=1.0
# export CLEF_PREFIX_CACHE_RESERVE_MIB=256
# export CLEF_PREFIX_CACHE_PREFILL_RESERVE_MIB=512
# export CLEF_PREFIX_CACHE_MIB=auto

# One FIFO inference worker per service. Limits include all image/text payloads.
# export CLEF_QUEUE_MAX_WAITING=64
# export CLEF_QUEUE_WAIT_SECONDS=300
# Wire-byte budget includes incoming, queued and active requests (not a RAM cap).
# export CLEF_QUEUE_PAYLOAD_MIB=256
# export CLEF_REQUEST_BODY_MIB=224
# Unified launcher / Docker Compose defaults
CLEF_PROFILE=flash
# Compose selects one host GPU; use a UUID for a stable assignment.
CLEF_GPU=0
CLEF_PORT=8080
# CLI parent directory; Docker defaults to /data in the persistent volume.
# CLEF_CACHE_DIR=/var/lib/clef
