# Copy to /etc/clef/flash.env or /etc/clef/full.env and adjust.
# This is not a credential file.

# One GPU per service, as an index or UUID.
CUDA_VISIBLE_DEVICES=0
# Give each service on the same host its own port.
CLEF_PORT=8080

# Optional: authenticated Hugging Face downloads (both pinned releases are public).
# HF_TOKEN=

# Everything below is optional. Values shown are the defaults.

# Input limits: computed from free GPU memory unless set to fixed.
# CLEF_CONTEXT_LIMIT_MODE=auto
# CLEF_MAX_LENGTH=16384
# CLEF_MAX_IMAGE_LENGTH=24576          # Flash; Full defaults to auto

# Incremental prefill for long inputs; image prefill is on by default.
# CLEF_IMAGE_PREFILL=1
# CLEF_PREFILL_INITIAL_CHUNK_TOKENS=8192
# CLEF_PREFILL_CHUNK_TOKENS=4096

# Exact-prefix cache in GPU memory.
# CLEF_PREFIX_CACHE=1
# CLEF_PREFIX_CACHE_MIB=auto
# CLEF_PREFIX_CACHE_ENTRIES=32
# CLEF_PREFIX_CACHE_RESERVE_MIB=256
# CLEF_PREFIX_CACHE_PREFILL_RESERVE_MIB=512
# CLEF_PREFIX_CACHE_ELASTIC=1

# Experimental 2x2 visual-token pooling.
# CLEF_IMAGE_POOLING=0

# Preprocessing, token and image feature reuse.
# CLEF_INPUT_CACHE=1
# CLEF_PREPROCESS_CACHE_MIB=256
# CLEF_TOKEN_CACHE_MIB=8
# CLEF_IMAGE_FEATURE_CACHE_MIB=256

# FIFO queue in front of the single GPU worker.
# CLEF_QUEUE_MAX_WAITING=64
# CLEF_QUEUE_WAIT_SECONDS=300
# CLEF_QUEUE_PAYLOAD_MIB=256
# CLEF_REQUEST_BODY_MIB=224
